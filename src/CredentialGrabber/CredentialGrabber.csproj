<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!--
      必须显式钉死平台，不能让 Playwright 自己推断。

      Microsoft.Playwright.targets 用 %(RuntimePack.RuntimeIdentifier) / $(RuntimeIdentifier)
      推断出 $(PlaywrightPlatform)，再按它挑选要复制的 node 二进制。**一旦推断值没能匹配上
      它硬编码的那几个分支（win / win-x64 / linux-x64 / linux-arm64 / osx-x64 / osx-arm64），
      就会命中 `@(_PlaywrightCopyItems->Count()) == '0'` 的兜底分支——把 5 个平台的 node 全复制一遍。**

      实测过一次：把 TargetFramework 从 net8.0-windows 改成 net8.0-windows10.0.18362.0，
      推断链就落进了兜底，产物里多出 darwin-arm64 / darwin-x64 / linux-arm64 / linux-x64
      四个用不到的 node（约 388 MB），zip 从 118 MB 涨到 254 MB。exe 本身完全正常，
      体积异常是唯一线索——很难发现。

      写死 win-x64 后，两个 TFM 下都只复制 win32_x64，不会再回退。
      build.yml / release.yml 另有断言：node 目录下只允许存在 win32_x64。
    -->
    <PlaywrightPlatform>win-x64</PlaywrightPlatform>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>CredentialGrabber</AssemblyName>
    <RootNamespace>CredentialGrabber</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.47.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- F12 控制台脚本作为嵌入资源，运行时释放给用户 -->
    <EmbeddedResource Include="assets\console-snippet.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- 可选的浏览器内核安装脚本，随发布目录一起分发 -->
    <Content Include="install-browser.cmd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!--
      MIT 要求分发副本时一并给出许可证与版权声明。发布流程只打包 publish/ 目录，
      仓库根目录的 LICENSE 默认不会进去，所以必须显式挂到发布清单上。
      否则用户拿到的是一个「只有二进制、没有许可文本」的包。
    -->
    <None Include="$(MSBuildThisFileDirectory)..\..\LICENSE">
      <Link>LICENSE</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!--
    丢掉 NuGet 包自带的 playwright.ps1。

    该脚本做的是 [Reflection.Assembly]::Load(ReadAllBytes("Microsoft.Playwright.dll"))
    然后调 [Microsoft.Playwright.Program]::Main($args)。单文件发布会把
    Microsoft.Playwright.dll 打进 exe，磁盘上不会留这个 dll，于是脚本必然抛
    FileNotFoundException + TypeNotFound。也就是说：它在我们的发布形态下
    **永远不可能成功**，留在目录里只会误导用户去执行它。

    改由 install-browser.cmd 承担同样职责——直接用随包的 node 驱动跑
    package\cli.js install chromium，不依赖任何托管 dll，单文件模式下可用。

    包是通过 Microsoft.Playwright.targets 的 CopyPlaywrightFilesToOutput 把
    playwright.ps1 以 Content + Link 加进来的，这里在它之后按文件名摘掉，
    使 bin 与 publish 两侧都不再出现。
  -->
  <Target Name="DropBrokenPlaywrightScript" AfterTargets="CopyPlaywrightFilesToOutput">
    <ItemGroup>
      <_BrokenPlaywrightScript Include="@(Content)" Condition="'%(Filename)%(Extension)' == 'playwright.ps1'" />
      <_BrokenPlaywrightScript Include="@(None)" Condition="'%(Filename)%(Extension)' == 'playwright.ps1'" />
      <Content Remove="@(_BrokenPlaywrightScript)" />
      <None Remove="@(_BrokenPlaywrightScript)" />
    </ItemGroup>
    <Message Importance="normal" Text="已移除不可用的 playwright.ps1（共 @(_BrokenPlaywrightScript->Count()) 项）。" />
  </Target>

  <!--
    Playwright 的 node 驱动必须和 exe 放在一起，否则运行时会抛
    "Driver not found: <exe目录>\.playwright\node\win32_x64\node.exe"。

    构建阶段驱动会被正常复制到 bin 输出（Microsoft.Playwright.targets 以
    Content + CopyToOutputDirectory 引入），但**单文件发布时会整个丢掉**：
    node.exe 本身是 .exe，被单文件那套「原生库」逻辑从发布清单里剔除，
    却又没有真正打进 exe（实测 exe 体积不变）。package\ 和 LICENSE 反而正常，
    所以光看发布目录很容易以为一切正常——必须专门断言 node.exe 在不在。

    这里在发布复制之前，把驱动目录整体重新挂回 @(ResolvedFileToPublish)，
    并显式 ExcludeFromSingleFile，避免再被剔除。
    源取 $(OutDir) 下的 .playwright：构建阶段已按当前 RID 复制好，内容完整。
  -->
  <Target Name="EnsurePlaywrightDriverIsPublished"
          AfterTargets="ComputeFilesToPublish"
          BeforeTargets="CopyFilesToPublishDirectory">

    <ItemGroup>
      <!-- 先摘掉清单里已有的 Playwright 条目，避免同一路径被复制两次 -->
      <_PlaywrightPublishedAlready Include="@(ResolvedFileToPublish)"
                                   Condition="$([System.String]::Copy('%(RelativePath)').StartsWith('.playwright'))" />
      <ResolvedFileToPublish Remove="@(_PlaywrightPublishedAlready)" />

      <!-- 双保险：即便 DropBrokenPlaywrightScript 因目标顺序失效，也确保它不进发布目录 -->
      <_BrokenScriptInPublish Include="@(ResolvedFileToPublish)"
                              Condition="'%(Filename)%(Extension)' == 'playwright.ps1'" />
      <ResolvedFileToPublish Remove="@(_BrokenScriptInPublish)" />

      <_PlaywrightDriverFile Include="$([MSBuild]::EnsureTrailingSlash('$(OutDir)')).playwright\**\*" />
      <ResolvedFileToPublish Include="@(_PlaywrightDriverFile)">
        <RelativePath>.playwright\%(_PlaywrightDriverFile.RecursiveDir)%(_PlaywrightDriverFile.Filename)%(_PlaywrightDriverFile.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <AssetType>content</AssetType>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        <Visible>false</Visible>
      </ResolvedFileToPublish>
    </ItemGroup>

    <Message Importance="high"
             Text="Playwright driver: 已把 @(_PlaywrightDriverFile->Count()) 个文件重新挂回发布清单。" />
  </Target>

</Project>
