<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      必须带 Windows 平台版本，否则 NuGet 会挑中 CommunityToolkit.WinUI.Notifications
      的 lib/net5.0 精简版（只有 ToastContentBuilder，没有 Show() 与 ToastNotificationManagerCompat）。
      带版本后解析到 lib/net5.0-windows10.0.18362，桌面通知管理器才可用。
    -->
    <TargetFramework>net8.0-windows10.0.18362.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ZzzAutoSign</AssemblyName>
    <RootNamespace>ZzzAutoSign</RootNamespace>
    <!-- 托盘程序需要，避免控制台窗口 -->
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="CommunityToolkit.WinUI.Notifications" Version="7.1.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      MIT 要求分发副本时一并给出许可证与版权声明。发布流程只打包 publish/ 目录，
      仓库根目录的 LICENSE 默认不会进去，所以必须显式挂到发布清单上。
      否则用户拿到的是一个「只有二进制、没有许可文本」的包。
    -->
    <None Include="$(MSBuildThisFileDirectory)..\..\LICENSE">
      <Link>LICENSE</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
